# Complete production-variable template. Values that are secrets are placeholders.
# Never commit a real .env, APP_KEY, password, access token or database export.
APP_NAME="Vidya Counseling Centre"
APP_ENV=production
# Generate a new key for a fresh LOCAL install only. Preserve the existing production key.
APP_KEY=
APP_DEBUG=false
APP_URL=https://vidyacounselling.com
ASSET_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=daily
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=vidya_session
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
STAGING_PROTECTION=false
